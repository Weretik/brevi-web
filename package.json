{
  "name": "brevi-web",
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "ng": "ng",
    "start": "nx serve",
    "build": "nx build",
    "watch": "nx build --watch --configuration development",
    "test": "nx test",
    "test:web": "npm run test:web:unit && npm run test:web:component && npm run test:web:integration",
    "test:web:unit": "nx test admin-react -- .unit.test. --passWithNoTests",
    "test:web:component": "nx test admin-react -- .component.test.",
    "test:web:integration": "nx test admin-react -- .integration.test. --passWithNoTests",
    "test:web:coverage": "nx test admin-react --coverage",
    "test:web:e2e": "nx e2e admin-react-e2e",
    "typecheck:tests:web": "nx run admin-react:typecheck-tests",
    "typecheck:tests:e2e": "nx run admin-react-e2e:typecheck",
    "typecheck:tests": "npm run typecheck:tests:web && npm run typecheck:tests:e2e",
    "docs:check": "node tools/docs/check-markdown.mjs",
    "docs:format:check": "prettier --check \"docs/**/*.md\"",
    "storefront:start": "node dist/apps/storefront/server/server.mjs",
    "serve:ssr:brevi-web": "node dist/brevi-web/server/server.mjs",
    "lint": "npx eslint \"{apps,libs}/**/*.{ts,html}\"",
    "lint:fix": "npx eslint \"{apps,libs}/**/*.{ts,html}\" --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "tokens:gen": "node tools/tokens/generate-tailwind-palette.mjs",
    "contracts:sync": "node tools/contracts/contracts.mjs sync",
    "contracts:generate": "node tools/contracts/contracts.mjs generate",
    "contracts:check": "node tools/contracts/contracts.mjs check"
  },
