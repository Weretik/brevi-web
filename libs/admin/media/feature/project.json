{
  "name": "admin-media-feature",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/admin/media/feature/src",
  "projectType": "library",
  "tags": ["scope:admin", "domain:media", "type:feature"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint .", "cwd": "libs/admin/media/feature" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.lib.json",
        "cwd": "libs/admin/media/feature"
      }
    },
    "typecheck-tests": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.spec.json",
        "cwd": "libs/admin/media/feature"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run", "cwd": "libs/admin/media/feature" }
    }
  }
}
